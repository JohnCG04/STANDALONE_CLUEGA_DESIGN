# ─── Required ────────────────────────────────────────────────────────────────
# Signs the `app_auth` session cookie. Any long random string (e.g. `openssl rand -hex 32`).
# Unset in development → a built-in dev secret; unset in production → every login fails.
APP_AUTH_SECRET=

# The CDP core API. Server-side: the /api/v1 proxy and the login route call it.
# CDP_BACKEND_URL wins; NEXT_PUBLIC_CDP_API_URL is the fallback.
CDP_BACKEND_URL=https://cdp-stg-core-api.cluega.com
NEXT_PUBLIC_CDP_API_URL=https://cdp-stg-core-api.cluega.com

# ─── Recommended ─────────────────────────────────────────────────────────────
# This app's own public URL (metadata, safe return paths after login).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public base of uploaded artifact files (workflow image/video previews).
NEXT_PUBLIC_ARTIFACT_PUBLIC_BASE_URL=https://cdp-stg-core-api.cluega.com/media/artifact-files
# Media AI service; also an allowed origin of the /api/artifacts/media/image proxy.
NEXT_PUBLIC_MEDIA_AI_API_URI=https://cdp-stg-ai-media.cluega.com
# Extra comma-separated origins the canvas image proxy may fetch from.
MEDIA_IMAGE_PROXY_ORIGINS=
# Mid-platform API (profile, wallet balance in the sidebar footer).
NEXT_PUBLIC_MID_PLATFORM_API_URL=
# Base URL used when building public links to this app.
NEXT_PUBLIC_APP_PUBLIC_BASE_URL=
# Google Tag Manager container. Unset → the default Cluega container.
NEXT_PUBLIC_GTM_ID=

# ─── Optional ────────────────────────────────────────────────────────────────
# Brand Kit font picker; without it a curated font list is used.
GOOGLE_FONTS_API_KEY=
# Help center (landing site) for help / register links.
NEXT_PUBLIC_HELP_ZONE_URL=
# Cloudflare Turnstile on the login form. Set BOTH or NEITHER, and add this
# app's domain to the Turnstile widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Install time (not read by the app) ──────────────────────────────────────
# GitHub Packages token for the private @dogclaw-ad/* packages (classic PAT with
# read:packages). npm reads it from the environment via .npmrc, not from this file:
#   export NPM_TOKEN=...   (locally)   |   Vercel → Project → Environment Variables
# NPM_TOKEN=

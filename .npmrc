# Private @dogclaw-ad packages live on GitHub Packages. The token comes from the
# environment — locally `export NPM_TOKEN=...` (a classic PAT with read:packages),
# on Vercel a project env var named NPM_TOKEN. Never write a literal token here.
@dogclaw-ad:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
